#include<stdio.h>
int main() {
	printf("输入两个正整数\n");
	int a = 0;
	int b = 0;
	int c = 0;
	int number = 0;
	int dan = 0;
	int shuang = 0;
	int thr = 0;

	printf("输入第一个\n");
	scanf_s("%d", &a);
	printf("输入第二个\n");
	scanf_s("%d", &b);
	if (b > a) {
		c = a;
		a = b;
		b = c;
	}
	for (number = b;number <= a;number++) {
		if (number % 2 == 0) {
			shuang++;
		}
		else {
			dan++;
		}
		if (number % 3 == 0) {
			thr++;
		}
	}
	printf("你输入的两个正整数之间有\n单数%d个\n双数%d个\n3的倍数%d个\n",dan,shuang,thr);
}
