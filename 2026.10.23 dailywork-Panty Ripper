//我的代码有很多问题，以下是deepseek修改版

#include <stdio.h>

int main() {
    int n;
    printf("请输入数字个数：");
    scanf_s("%d", &n);

    if (n <= 0 || n > 100) {
        printf("范围错误\n");
        return 0;
    }

    int arr[100];
    for (int i = 0; i < n; i++) {
        scanf_s("%d", &arr[i]);
    }

    // ========== 指针登场 ==========
    int *p;   // 定义一个 int 类型的指针

    // 1. 正着打印
    printf("正着打印：");
    for (p = arr; p < arr + n; p++) {
        // p 指向数组开头，p++ 往后走
        printf("%d ", *p);  // *p 就是取 p 指向的值
    }
    printf("\n");

    // 2. 倒着打印
    printf("倒着打印：");
    for (p = arr + n - 1; p >= arr; p--) {
        // p 指向最后一个元素，p-- 往前走
        printf("%d ", *p);
    }
    printf("\n");

    return 0;
}
