#include<stdio.h>
int main() {
	printf("输入行数n，我会生成对应行数的数字三角形\n");
	int number = 0; //行的记录次数
	int input = 0;  //要搞多少行
	int output = 0; //输出的
	int a = 0;  //寄存输出的
	scanf_s("%d", &input);
	if (input == 0) {
		printf("输入了生成0行的数字三角，生成空白\n");
		return 0;
	}
	for (number = 1;number <= input;number++) {
		output = 0;
		printf("\n");  //这一行放到（1）更好
		for (a=1;a <= number;a++) {
			
			output++;
			printf("%d ", output);

		}
		  // <--(1)
	}
	return 0;
}
