#include<stdio.h>
int main() {
	printf("输入你想输入几个数字以及输入，我会倒着打印\n");
	int n = 0;
	scanf_s("%d", &n);
	if (n <= 0) {
		printf("你输入的是非正整数，请重新进程\n");
		return 0;
	}
	
	
	int arr[999];
	int arr_n = 999;
	int number = 0;
	int input = 0;
	for (;number+1 <= n;number++) {
		printf("请输入第%d个数值:\n", number + 1);
		scanf_s("%d", &input);
		arr[number] = input;

	}
	
	for (number = n - 1;number >= 0;number--) {
		printf("%d\n", arr[number]);

	}
	return 0;
}
