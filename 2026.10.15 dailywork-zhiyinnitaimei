//以下是deepseek的解析原代码作为反思示例

#include <stdio.h>

int main() {
    int n;
    printf("请输入一个大于 1 的正整数：");
    scanf_s("%d", &n);

    if (n <= 1) {
        printf("请输入大于 1 的正整数\n");
        return 0;
    }

    printf("%d = ", n);

    int temp = n;   // 保存原数用于打印

    for (int i = 2; i <= temp; i++) {
        while (temp % i == 0) {
            printf("%d", i);
            temp /= i;
            if (temp > 1) printf(" × ");
        }
    }
    printf("\n");

    return 0;
}
