#include <stdio.h>

int main() {
    int n;
    printf("请输入数字个数：");
    scanf_s("%d", &n);

    // 1. 判断边界（用 ||）
    if (n <= 0 || n > 100) {
        printf("输入不在范围内\n");
        return 0;
    }

    int arr[100];
    printf("请输入 %d 个数：\n", n);
    for (int i = 0; i < n; i++) {
        scanf_s("%d", &arr[i]);
    }

    // 2. 冒泡排序
    for (int i = 0; i < n - 1; i++) {
        for (int j = 0; j < n - 1 - i; j++) {
            if (arr[j] > arr[j + 1]) {
                // 交换
                int temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
            }
        }
    }

    // 3. 打印结果
    printf("排序后：");
    for (int i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n");

    return 0;
}

