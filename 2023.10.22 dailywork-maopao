//以下是我这种思想完整版本，由deepseek提供

#include <stdio.h>

int main() {
    int n;
    printf("请输入数字个数：");
    scanf_s("%d", &n);

    int arr[100];
    printf("请输入这些数：\n");
    for (int i = 0; i < n; i++) {
        scanf_s("%d", &arr[i]);
    }

    // 按照你的思路：把数字拿出来，找位置，挪动
    for (int i = 1; i < n; i++) {
        int current = arr[i];   // 把当前要排序的数“拿出来”存好（相当于你拿在手里的牌）
        int j = i - 1;          // 从它前面的那个数开始往前比

        // 你的原话：“比较第一个数，要是小于就记住...发现比他大就开始比第二个”
        // 代码翻译：只要前面的数比 current 大，就把前面的数往后挪一格
        while (j >= 0 && arr[j] > current) {
            arr[j + 1] = arr[j];  // 把第 j 个数往后挪一格，腾出位置
            j--;                  // 继续往前看更前面的数
        }

        // 挪完之后，空出来的位置放上 current
        // 注意：因为上面 j 最后又减了 1，所以空出来的位置是 j + 1
        arr[j + 1] = current;
    }

    printf("排序后：");
    for (int i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n");

    return 0;
}
