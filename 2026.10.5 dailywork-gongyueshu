#include <stdio.h>

int main() {
    int a, b;
    printf("请输入两个正整数：");
    scanf_s("%d %d", &a, &b);

    if (a == 0 || b == 0) {
        printf("两数不能为 0\n");
        return 0;
    }

    int min;
    if (a < b) {
        min = a;
    } else {
        min = b;
    }

    int gcd = 1;
    for (int i = 1; i <= min; i++) {
        if (a % i == 0 && b % i == 0) {
            gcd = i;
        }
    }

    printf("最大公约数是：%d\n", gcd);
    return 0;
}
