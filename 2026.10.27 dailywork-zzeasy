#include<stdio.h>
int main() {
	printf("输入两个数字\n");
	int a = 0;
	int b = 0;
	printf("现在输入第一个:\n");
	scanf_s("%d", &a);
	printf("输入第二个:\n");
	scanf_s("%d", &b);
	int* p = &a;
	int* q = &b;
	printf("输入前:a=%d b=%d\n", a, b);
	int temp = *p;
	*p = *q;
	*q = temp;
	printf("修改后: a=%d b=%d", a, b);
	return 0;
}
