#include<stdio.h>
int main() {
	int number = 52;
	int user = 0;
	printf("请输入数字来猜猜数字炸弹是多少，不限次数\n数字范围0-100\n");
	scanf_s("%d", &user);
	while (number == 52) {
		if (user > number&&user<=100) {
			printf("你输入的值大了\n接着输入\n");
		}
		else if (user < number&& user>=0) {
			printf("你输入的值小了\n接着输入\n");
		}
		else if (user < 0) {
			printf("我们的范围是非负数\n");
		}
		else if (user > 100) {
			printf("你输入的值太大了，接着猜，还有记得读题\n");
		}
		else {
			printf("正确！就是52\n");
			return 0;  //可以用break，这个更好，与return 0 不同的是，break会只跳出循环接着往下的步骤而不是直接退出整个main
		}
		scanf_s("%d", &user);  //建议删去，这一行与第6行的用途相重复
		
	}
	
	return 0;
}
