#include <stdio.h>

int main() {
    int n;
    printf("请输入数字个数：");
    scanf_s("%d", &n);

    int x;  
    int max, min;

    // 先读第一个数，作为 max 和 min 的初始值
    printf("请输入第 1 个数：");
    scanf_s("%d", &x);
    max = x;
    min = x;

    // 从第二个数开始比较
    for (int i = 2; i <= n; i++) {
        printf("请输入第 %d 个数：", i);
        scanf_s("%d", &x);

        if (x > max) max = x;
        if (x < min) min = x;
    }

    printf("最大值是：%d\n", max);
    printf("最小值是：%d\n", min);

    return 0;
}
