#include<stdio.h>
int main() {
	printf("输入一个值，我会告诉你0到这个数值内奇数和偶数分别有多少个\n");
	int input = 0;
	int number = 0;
	int a = 0;
	int b = 0;
	scanf_s("%d", &input);
	if (input == 0) {
		printf("输入的值为0，奇数和偶数的个数都是0");
		return 0;
	}
	for (number = 1;input >= number;number++) {
		if (number % 2 != 0) {
			a++;
		}
		else if (number % 2 == 0) {
			b++;
		}
	}
	printf("在0到%d之间有%d个奇数和%d个偶数", input, a, b);
	return 0;
}
