#include<stdio.h>
int main() {
	printf("输入首项 a、公差 d、项数 n，我会倒着打印数列\n");
	int a = 0;
	int d = 0;
	int n = 0;
	int b = 0;
	int number = 0;
	
	printf("输入首项\n");
	scanf_s("%d", &a);
	printf("输入公差\n");
	scanf_s("%d", &d);
	printf("输入项数\n");
	scanf_s("%d", &n);
	b = a + d * （n-1）;  //等差数列的末项是首相加上n-1个公差！！！
	for (number = 1;number <= n;number++) {
		printf("%d", b);
		b -= d;
		
	}
	return 0;
}
