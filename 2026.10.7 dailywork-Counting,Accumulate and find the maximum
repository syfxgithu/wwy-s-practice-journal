#include<stdio.h>
int main() {
	printf("输入一串数字，我会告诉你\n这是几位数\n他们之中最大的数\n这一串数字所有数字之和\n");
	int input = 0;
	int number = 0;
	int output = 0;
	int a = 0;
	int b = 0;
	int bt = 0;
	int c = 0;
	scanf_s("%d", &input);
	int original = input;
	if (input <= 0) {
		printf("你输入的值为非正整数，请输入正整数\n");
		return 0;
	}
	a = input;
	for (;a != 0;number++) {
		a /= 10;

	}
	a = number; //几位数
	bt = input;
	while (1) {
		number = 0;
		number = bt % 10;
		if (number > b) {
			b = number;
		}
		bt /= 10;
		if (bt == 0) {
			break;
		}
	} //最大数

	while (1) {
		c += input % 10;
		input /= 10;
		if (input <= 0) {
			break;
		}
	} //之和
	printf("这串数字%d为\n%d位数\n最大数为%d\n所以数字之和为%d\n", input, a, b, c);
	return 0;
}

