#include<stdio.h>
#include<math.h>
int main() {
	printf("请输入需要倒序的正整数\n");
	int number = 0;
	int record = 0;
	int middle = 0;
	int input = 0;
	int a = 0;	int b = 0;
	int c = 0;
	double d = 0;
	scanf_s("%d", &number);
	c = number;
	while (1) {
		c /= 10;
		b++;
		if (c == 0) {
			break;
		}
	}
	d = b - record;
	for (;number > record; record++) {
		middle = number % 10;
		number /= 10;
		a = middle * (int)pow(10, d);
		input += a;
	}
	printf("您所输入的数字倒序为： %d", input);
	return 0;
}



