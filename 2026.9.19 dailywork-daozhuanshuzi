//以下是示范性代码：
#include <stdio.h>

int main() {
    int n;
    printf("请输入一个正整数：");
    scanf_s("%d", &n);

    int result = 0;

    while (n > 0) {
        int digit = n % 10;            // 取末位
        result = result * 10 + digit;  // 拼到结果后面
        n = n / 10;                    // 去掉末位
    }

    printf("反转后是：%d\n", result);
    return 0;
}
