#include<stdio.h>
int main() {
	printf("输入你想输入几个正整数字，不得输入超过100个\n");
	int n = 0;
	int number = 0;
	scanf_s("%d", &n);
	int input = 0;
	int arr[100];
	if (n <= 0 || n > 100) {
		printf("你输入的数值不符合要求，请重新进程\n");
		return 0;
	}
	for (;number < n;number++) {
		printf("输入第%d个数:\n", number + 1);
		scanf_s("%d", &input);
		arr[number] = input;
		
	}
	printf("输入你需要查找的数字\n");
	int find = 0;
	
	scanf_s("%d", &find);
	for (number = 0;number < n;number++) {
		if (arr[number] == find) {
			printf("找到了！你要找到数 %d 在 下标%d", find, number);
			return 0;
		}
		else {
			continue;
		}
	}
	printf("未找到\n");
	return 0;
}
